# ~/swarm/ionic/users.env — shared secrets for per-user engines
#
# This file is mounted into every ionic-engine-<id> container that
# the provisioner spawns. It must contain ONLY the secrets that are
# safe to share across users:
#
#   ✅ BROKER_KEY_MASTER  — needed by every per-user engine to decrypt
#                           its own broker_keys row from global.db.
#                           Same value as operator's .env (one master
#                           key for the whole deployment).
#   ✅ BRAVE_API_KEY      — shared news source. Per-user engines query
#                           Brave for sentiment context.
#   ✅ OPENROUTER_API_KEY — shared LLM gateway (if you route to cloud
#                           LLMs as a fallback to LM Studio).
#
# This file must NEVER contain:
#
#   ❌ OANDA_API_KEY / OANDA_SECRET_KEY    — operator's broker creds.
#       Per-user engines must use their own creds from broker_keys.
#       The engine has a USER_ID-gated fallback to env, but only the
#       OPERATOR engine should reach that fallback.
#   ❌ TELEGRAM_BOT_TOKEN / TELEGRAM_USER_ID — operator's Telegram bot.
#       (Even though core/main.py also gates Telegram init on USER_ID,
#       belt-and-braces: don't expose the token to user processes.)
#   ❌ API_SECRET_KEY                         — JWT signing key. Only
#       the api container needs this.
#   ❌ API_PASSWORD_HASH / DEMO_PASSWORD_HASH — legacy operator + demo
#       auth hashes. Only api needs these.
#   ❌ POSTMARK_SERVER_TOKEN                  — transactional email key.
#       Only api needs this.
#
# Install:
#   cp ~/swarm/ionic/repo/scripts/users.env.example \
#      ~/swarm/ionic/users.env
#   # Then fill in the values below from your ~/swarm/ionic/.env
#   chmod 600 ~/swarm/ionic/users.env

# ── Broker credential decryption ──────────────────────────────────────
# Required. Same value as ~/swarm/ionic/.env. Per-user engines use
# this to decrypt their own row from global.db.broker_keys.
BROKER_KEY_MASTER=

# ── Shared 3rd-party API keys ─────────────────────────────────────────
# Optional. Per-user engines call Brave Search for sentiment context.
# If left empty, news features degrade gracefully.
BRAVE_API_KEY=

# Optional. Cloud LLM fallback if LM Studio is unavailable.
OPENROUTER_API_KEY=
