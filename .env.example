# Ionic — runtime secrets template.
# Copy to ~/swarm/ionic/.env (the swarm-root bind-mount location) and
# populate. chmod 600. Never commit the populated file.

# ── Oanda broker credentials ─────────────────────────────────────────
# Practice account keys are free + unlimited; live needs a funded
# account. OANDA_ENVIRONMENT determines which base URL the v20 client
# hits.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice   # "practice" or "live"

# ── Alpaca clock helper (stale — slated for removal) ────────────────
# Ionic's api/main.py still calls Alpaca's TradingClient.get_clock()
# for market-open status via a leftover scaffolding helper. Set these
# to ANYTHING (e.g. dummy strings) until that code is ripped out.
# Tracked in the audit follow-up: "Rip dead Alpaca-clock code from Ionic".
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── LLM consensus layer (Brave Search + local LM Studio) ─────────────
BRAVE_API_KEY=
# LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# ── Telegram bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ── Web dashboard auth ───────────────────────────────────────────────
API_SECRET_KEY=
API_USERNAME=admin
API_PASSWORD_HASH=
DEMO_USERNAME=demo
DEMO_PASSWORD_HASH=
CORS_ORIGINS=https://ionic.blisske.hopto.org

# ── Optional: API bind overrides (compose normally sets these) ───────
# AGENT_HOST=0.0.0.0
# AGENT_PORT=8002
